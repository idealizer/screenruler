<Window x:Class="ScreenRuler.LoupeOverlay"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenRuler"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Title="Pixel zoom">
    <Window.Resources>
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="Transparent" CornerRadius="10" SnapsToDevicePixels="True">
        <DockPanel>
            <DockPanel x:Name="Header" DockPanel.Dock="Top" Height="34" Margin="0,0,0,2" Background="#F20F172A">
                <TextBlock x:Name="Hint"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#FDE047"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="11"
                           Margin="8,0,8,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button x:Name="BtnZero" Content="Start" Click="Zero_Click" Style="{StaticResource ModeButton}"/>
                    <Button x:Name="BtnPointer" Content="End" Click="Pointer_Click" Style="{StaticResource ModeButton}" Margin="4,0,0,0"/>
                </StackPanel>
            </DockPanel>
            <local:LoupeGlass x:Name="Glass"
                              HorizontalAlignment="Center"
                              MouseMove="Glass_MouseMove"
                              MouseLeave="Glass_MouseLeave"
                              MouseLeftButtonDown="Glass_MouseLeftButtonDown"
                              MouseRightButtonDown="Glass_MouseRightButtonDown"
                              PreviewMouseWheel="Glass_PreviewMouseWheel"/>
        </DockPanel>
    </Border>
</Window>
