<Window x:Class="ScreenRuler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenRuler"
        Title="Screen Ruler"
        Width="800"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        DpiChanged="Window_DpiChanged"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="450"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#46FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#46FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#46FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="Transparent">
        <local:RulerSurface x:Name="Surface"/>
        <Border x:Name="StatusPill"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8,6,0,0"
                Padding="8,4"
                CornerRadius="8"
                Background="#F20F172A"
                BorderBrush="#552DD4BF"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                MaxWidth="220">
            <TextBlock x:Name="StatusText"
                       Foreground="#F8FAFC"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="ReadoutPill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="12,5"
                CornerRadius="10"
                BorderThickness="1"
                Cursor="Hand"
                Background="#F20F172A"
                BorderBrush="#552DD4BF"
                ToolTip="Double-click for sizes, or type width × height"
                MouseLeftButtonDown="Readout_MouseLeftButtonDown">
            <Border.LayoutTransform>
                <RotateTransform x:Name="ReadoutRotate" Angle="0"/>
            </Border.LayoutTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <TextBlock x:Name="ReadoutText"
                       Text="0 px"
                       Foreground="#F8FAFC"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"/>
        </Border>
        <Popup x:Name="SizePopup"
               PlacementTarget="{Binding ElementName=Root}"
               Placement="Custom"
               CustomPopupPlacementCallback="PlaceShotCard"
               StaysOpen="True"
               AllowsTransparency="True"
               Opened="SizePopup_Opened"
               PreviewKeyDown="SizePopup_PreviewKeyDown">
            <Border Background="#F20F172A" BorderBrush="#552DD4BF" BorderThickness="1" CornerRadius="12" Padding="12" Width="460">
                <StackPanel>
                    <TextBlock Text="Width × height" Foreground="#F8FAFC" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Margin="2,0,2,6"/>
                    <DockPanel Margin="0,0,0,12" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="Set"
                                Margin="8,0,0,0"
                                MinWidth="72"
                                MinHeight="40"
                                Style="{StaticResource CardButton}"
                                Click="SizeSet_Click"
                                AutomationProperties.Name="Set width and height"/>
                        <TextBox x:Name="SizeBox"
                                 MinHeight="40"
                                 Background="#14FFFFFF"
                                 BorderThickness="0"
                                 Padding="10,6"
                                 FontFamily="Segoe UI Variable, Segoe UI"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#F8FAFC"
                                 CaretBrush="#F8FAFC"
                                 SelectionBrush="#552DD4BF"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Type width × height, then Enter or Set"
                                 KeyDown="SizeBox_KeyDown"
                                 LostFocus="SizeBox_LostFocus"/>
                    </DockPanel>
                    <TextBlock Text="Screens" Foreground="#99F8FAFC" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Margin="4,0,4,2"/>
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource Chip}" Tag="1920x1080" Click="Preset_Click" AutomationProperties.Name="1920 by 1080, 16 by 9">
                            <StackPanel>
                                <TextBlock Text="1920×1080" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="16:9" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Chip}" Tag="1366x768" Click="Preset_Click" AutomationProperties.Name="1366 by 768 laptop">
                            <StackPanel>
                                <TextBlock Text="1366×768" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Laptop" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Chip}" Tag="1080x1920" Click="Preset_Click" AutomationProperties.Name="1080 by 1920, 9 by 16">
                            <StackPanel>
                                <TextBlock Text="1080×1920" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="9:16" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Style="{StaticResource Chip}" Tag="768x1024" Click="Preset_Click" AutomationProperties.Name="768 by 1024 tablet">
                            <StackPanel>
                                <TextBlock Text="768×1024" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tablet" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Chip}" Tag="390x800" Click="Preset_Click" AutomationProperties.Name="390 by 800 mobile">
                            <StackPanel>
                                <TextBlock Text="390×800" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mobile" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <TextBlock Text="Ads" Foreground="#99F8FAFC" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" Margin="4,0,4,2"/>
                    <UniformGrid Columns="4">
                        <Button Style="{StaticResource Chip}" Tag="728x90" Click="Preset_Click" AutomationProperties.Name="Leaderboard 728 by 90">
                            <StackPanel>
                                <TextBlock Text="728×90" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Leaderboard" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Chip}" Tag="300x250" Click="Preset_Click" AutomationProperties.Name="Medium rectangle 300 by 250">
                            <StackPanel>
                                <TextBlock Text="300×250" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Rectangle" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Chip}" Tag="300x600" Click="Preset_Click" AutomationProperties.Name="Half page 300 by 600">
                            <StackPanel>
                                <TextBlock Text="300×600" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Half-page" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Chip}" Tag="160x600" Click="Preset_Click" AutomationProperties.Name="Skyscraper 160 by 600">
                            <StackPanel>
                                <TextBlock Text="160×600" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Skyscraper" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="ShotPopup"
               PlacementTarget="{Binding ElementName=Root}"
               Placement="Custom"
               CustomPopupPlacementCallback="PlaceShotCard"
               StaysOpen="True"
               AllowsTransparency="True"
               Opened="ShotPopup_Opened"
               PreviewKeyDown="ShotPopup_PreviewKeyDown">
            <Border Background="#F20F172A" BorderBrush="#552DD4BF" BorderThickness="1" CornerRadius="12" Padding="10" Width="260">
                <StackPanel>
                    <Image x:Name="ShotPreview" MaxWidth="250" MaxHeight="140" Stretch="Uniform" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ShotFile"
                               Foreground="#F8FAFC"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Pictures\ScreenRuler"
                               Foreground="#FDE047"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="11"
                               Margin="0,2,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CardButton}" Content="Open" Click="ShotOpen_Click" AutomationProperties.Name="Open snapshot"/>
                        <Button Style="{StaticResource CardButton}" Content="Folder" Click="ShotFolder_Click" AutomationProperties.Name="Show snapshot folder"/>
                        <Button Style="{StaticResource CardButton}" Content="Close" Margin="0" Click="ShotClose_Click" AutomationProperties.Name="Close snapshot"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
        <Border x:Name="Dock"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="8,0,12,0"
                Padding="3"
                CornerRadius="12"
                Background="#D10F172A"
                BorderBrush="#332DD4BF"
                BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False">
            <UniformGrid x:Name="DockGrid" Rows="1" Columns="6">
                <Button x:Name="BtnFlip" Style="{StaticResource DockButton}" Content="&#xE7AD;"
                        ToolTip="Flip orientation (Ctrl+F)"
                        AutomationProperties.Name="Flip orientation"
                        Click="Flip_Click"/>
                <Button x:Name="BtnArea" Style="{StaticResource DockButton}" Content="&#xE7A8;"
                        ToolTip="Mark an area (Ctrl+3)"
                        AutomationProperties.Name="Mark an area"
                        Click="Area_Click"/>
                <Button x:Name="BtnZoom" Style="{StaticResource DockButton}" Content="&#xE71E;"
                        ToolTip="Pixel zoom (Z). Shows the top-left corner so you can place the start."
                        AutomationProperties.Name="Pixel zoom"
                        Click="Zoom_Click"/>
                <Button x:Name="BtnShot" Style="{StaticResource DockButton}" Content="&#xE722;"
                        ToolTip="Snapshot this area to the clipboard and Pictures"
                        AutomationProperties.Name="Snapshot area"
                        Click="Snapshot_Click"/>
                <Button x:Name="BtnUnit" Style="{StaticResource DockButton}" Content="&#xE799;"
                        ToolTip="Physical pixels. Click for logical DIPs."
                        AutomationProperties.Name="Toggle pixels or DIPs"
                        Click="Unit_Click"/>
                <Button x:Name="BtnContrast" Style="{StaticResource DockButton}" Content="&#xE706;"
                        ToolTip="Light ticks. Click for a bright background."
                        AutomationProperties.Name="Toggle contrast"
                        Click="Contrast_Click"/>
                <Button x:Name="BtnLock" Style="{StaticResource DockButton}" Content="&#xE785;"
                        ToolTip="Lock position"
                        AutomationProperties.Name="Lock position"
                        Click="Lock_Click"/>
                <Button x:Name="BtnHide" Style="{StaticResource DockButton}" Content="&#xE8BB;"
                        ToolTip="Hide (Esc). Ctrl+Alt+R brings it back."
                        AutomationProperties.Name="Hide ruler"
                        Click="Hide_Click"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
